/**
 * Trending service — uses a curated list of "trending" search queries,
 * runs them in parallel via yt-dlp, merges + dedupes the results, then
 * shuffles and returns a diverse mix. Cached for 15 minutes.
 */
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { app } from 'electron';
import type { TrendingResponse, VideoSearchResult } from '../../shared/types';
import { resolveBinary } from '../utils/binaries';
import { readSettings } from './settings';
import { createLogger } from '../utils/logger';
import { humanizeError } from '../utils/errors';

const execFileAsync = promisify(execFile);
const log = createLogger('trending');

/** How many items to fetch per query */
const PER_QUERY = 6;
/** Max simultaneous yt-dlp processes (batching) */
const CONCURRENCY = 3;
/** Cache TTL (15 minutes) */
const CACHE_TTL_MS = 45 * 60 * 1000;

/** Curated "trending" queries — mixes regions and genres. */
const TRENDING_QUERIES = [
  'trending music 2026',
  'top hits this week',
  'popular songs now',
  'viral songs today',
  'chart hits',
  'new music releases',
  'best songs right now',
  'hot tracks',
  'trending afrobeat',
  'trending bongo flava',
  'trending dancehall',
  'trending gospel',
  'trending hip hop',
  'new ugandan music',
];

interface RawEntry {
  id: string;
  webpage_url?: string;
  title: string;
  channel?: string;
  uploader?: string;
  duration?: number;
  duration_string?: string;
  view_count?: number;
  upload_date?: string;
  thumbnails?: { url: string; height?: number }[];
}

interface RawResponse {
  entries?: RawEntry[];
}

/* ------------------------------ caching ---------------------------------- */

interface CacheEntry {
  response: TrendingResponse;
  at: number;
}

let cache: CacheEntry | null = null;

/* ------------------------------ utilities -------------------------------- */

function normaliseDate(d?: string): string | null {
  if (!d || d.length !== 8) return null;
  return `${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}`;
}

function detectRegion(): string {
  try {
    const locale = app.getLocale();
    const parts = locale.split(/[-_]/);
    if (parts.length >= 2) {
      const country = parts[1].toUpperCase();
      if (/^[A-Z]{2}$/.test(country)) return country;
    }
  } catch {
    // ignore
  }
  return 'US';
}

function mapEntry(e: RawEntry): VideoSearchResult {
  const thumb =
    e.thumbnails?.at(-1)?.url ??
    (e.id ? `https://i.ytimg.com/vi/${e.id}/mqdefault.jpg` : null);

  return {
    id: e.id,
    url: e.webpage_url ?? `https://www.youtube.com/watch?v=${e.id}`,
    title: e.title ?? '(untitled)',
    channel: e.channel ?? e.uploader ?? null,
    duration: e.duration ?? null,
    durationString: e.duration_string ?? null,
    thumbnail: thumb,
    viewCount: e.view_count ?? null,
    uploadDate: normaliseDate(e.upload_date),
  };
}

async function runQuery(
  bin: string,
  query: string,
  region: string,
): Promise<VideoSearchResult[]> {
  const args = [
    '--dump-single-json',
    '--flat-playlist',
    '--no-warnings',
    '--extractor-retries', '2',
    '--socket-timeout', '20',
    '--geo-bypass',
    '--geo-bypass-country', region,
    '--playlist-end', String(PER_QUERY),
    `ytsearch${PER_QUERY}:${query}`,
  ];

  try {
    const { stdout } = await execFileAsync(bin, args, {
      maxBuffer: 1024 * 1024 * 32,
      timeout: 25_000,
    });
    const raw = JSON.parse(stdout) as RawResponse;
    return (raw.entries ?? []).map(mapEntry);
  } catch (err) {
    log.warn('query failed', query, String(err));
    return [];
  }
}

/** Run promises in batches to avoid spawning 14 processes at once. */
async function runInBatches<T>(
  tasks: (() => Promise<T>)[],
  concurrency: number,
): Promise<T[]> {
  const results: T[] = [];
  for (let i = 0; i < tasks.length; i += concurrency) {
    const batch = tasks.slice(i, i + concurrency).map((t) => t());
    const batchResults = await Promise.all(batch);
    results.push(...batchResults);
  }
  return results;
}

function shuffle<T>(arr: T[]): T[] {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

/* --------------------------------- fetch --------------------------------- */

export async function getTrending(forceRefresh = false): Promise<TrendingResponse> {
  if (!forceRefresh && cache && Date.now() - cache.at < CACHE_TTL_MS) {
    return { ...cache.response, cached: true };
  }

  const settings = readSettings();
  const bin = resolveBinary('yt-dlp', settings.ytDlpPath);
  const region = detectRegion();

  log.info('fetching trending', `region=${region}`, `queries=${TRENDING_QUERIES.length}`);

  const tasks = TRENDING_QUERIES.map((q) => () => runQuery(bin, q, region));
  const batches = await runInBatches(tasks, CONCURRENCY);
  const all = batches.flat();

  // Dedupe by video id
  const seen = new Set<string>();
  const unique: VideoSearchResult[] = [];
  for (const item of all) {
    if (seen.has(item.id)) continue;
    seen.add(item.id);
    unique.push(item);
  }

  if (unique.length === 0) {
    throw new Error('No trending results could be fetched.');
  }

  // Shuffle for a diverse mix
  const items = shuffle(unique);

  const response: TrendingResponse = {
    region,
    fetchedAt: Date.now(),
    cached: false,
    items,
  };

  cache = { response, at: Date.now() };
  log.info('trending OK', `unique=${items.length}`);
  return response;
}